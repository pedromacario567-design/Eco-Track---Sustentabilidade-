
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --green: #198754;
  --dark: #173c2c;
  --light: #f1f8f3;
  --white: #ffffff;
  --gray: #68756d;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'Inter', sans-serif;
  background: #f8faf8;
  color: var(--dark);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22px 9%;
  background: white;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--green);
  font-size: 24px;
  font-weight: 800;
  text-decoration: none;
}

.logo img {
  width: 38px;
}

nav {
  display: flex;
  gap: 25px;
}

nav a {
  color: var(--dark);
  text-decoration: none;
  font-weight: 600;
}

.container {
  max-width: 1100px;
  margin: auto;
  padding: 55px 25px;
}

.welcome {
  background: var(--light);
  border-radius: 24px;
  padding: 65px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 30px;
}

.tag {
  color: var(--green);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
}

.welcome h1 {
  font-size: clamp(32px, 5vw, 52px);
  margin: 18px 0;
  line-height: 1.15;
}

.welcome h1 span {
  color: var(--green);
}

.welcome p {
  color: var(--gray);
  max-width: 450px;
  line-height: 1.8;
  margin-bottom: 25px;
}

.hero-icon {
  font-size: 140px;
}

.button {
  display: inline-block;
  border: none;
  border-radius: 10px;
  padding: 14px 22px;
  background: var(--green);
  color: white;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
}

.button:hover {
  background: #116c40;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin: 35px 0;
}

.stat-card {
  background: white;
  border: 1px solid #e5eee7;
  border-radius: 16px;
  padding: 28px;
}

.stat-card > span {
  font-size: 28px;
}

.stat-card h2 {
  font-size: 30px;
  margin: 12px 0 5px;
  color: var(--green);
}

.stat-card p {
  color: var(--gray);
  font-size: 14px;
}

.activities, .about {
  background: white;
  padding: 35px;
  border-radius: 18px;
  margin-top: 25px;
}

.activities h2, .about h2 {
  margin-top: 12px;
}

.activity-list {
  margin: 25px 0;
}

.activity-item {
  padding: 16px;
  background: var(--light);
  border-radius: 10px;
  margin-bottom: 10px;
}

.empty {
  color: var(--gray);
}

.activity-form {
  display: grid;
  gap: 15px;
  max-width: 450px;
}

.activity-form select {
  padding: 13px;
  border: 1px solid #dce7df;
  border-radius: 8px;
}

.about p {
  color: var(--gray);
  line-height: 1.8;
  margin-top: 15px;
}

footer {
  text-align: center;
  padding: 30px;
  color: var(--gray);
}

@media (max-width: 650px) {
  .header {
    flex-direction: column;
    gap: 18px;
  }

  nav {
    gap: 15px;
  }

  .welcome {
    padding: 30px;
  }

  .hero-icon {
    display: none;
  }

  .stats {
    grid-template-columns: 1fr;
  }
}
